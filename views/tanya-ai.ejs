<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">

  <%- include('partials/navbar') %>

  <main class="flex-1 max-w-2xl mx-auto px-4 py-10 w-full">
    <h1 class="text-2xl font-bold mb-2">Tanya AI</h1>
    <p class="text-gray-500 mb-6">Punya pertanyaan seputar stok, harga, atau jam buka toko? Tanya di sini!</p>

    <section class="bg-white rounded-lg shadow flex flex-col h-[420px]" aria-label="Kotak percakapan">
      <!-- Area chat -->
      <div id="chatBox" class="flex-1 overflow-y-auto p-4 space-y-3">
        <div class="bg-green-100 text-green-900 rounded-lg px-4 py-2 max-w-[80%] text-sm">
          Halo! Aku asisten AI Toko Sembako Ariesta. Ada yang bisa dibantu? (Fitur balasan otomatis akan aktif di Sprint 2)
        </div>
      </div>

      <!-- Form input pesan -->
      <form id="chatForm" class="border-t border-gray-200 p-3 flex gap-2" aria-label="Form kirim pertanyaan">
        <label for="pesan" class="sr-only">Tulis pertanyaan kamu</label>
        <input
          type="text"
          id="pesan"
          name="pesan"
          placeholder="Tulis pertanyaan kamu di sini..."
          required
          class="flex-1 border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-green-500"
        />
        <button type="submit" class="bg-green-600 text-white font-medium px-5 py-2 rounded hover:bg-green-700 transition">
          Kirim
        </button>
      </form>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>
