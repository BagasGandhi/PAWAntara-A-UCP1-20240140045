<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">

  <%- include('partials/navbar') %>

  <main class="flex-1 max-w-4xl mx-auto px-4 py-10 w-full">
    <% if (!product) { %>
      <!-- Kasus ID tidak ditemukan -->
      <section class="bg-white rounded-lg shadow p-10 text-center" aria-labelledby="notfound-heading">
        <div class="text-5xl mb-4">😕</div>
        <h1 id="notfound-heading" class="text-2xl font-bold mb-2">Produk Tidak Ditemukan</h1>
        <p class="text-gray-500 mb-6">Maaf, produk dengan ID tersebut tidak ada di daftar kami.</p>
        <a href="/produk" class="inline-block bg-green-600 text-white font-medium px-6 py-2 rounded hover:bg-green-700 transition">
          Kembali ke Daftar Produk
        </a>
      </section>
    <% } else { %>
      <!-- Detail produk -->
      <article class="bg-white rounded-lg shadow overflow-hidden md:flex">
        <div class="bg-green-50 md:w-1/3 flex items-center justify-center text-7xl py-10">
          📦
        </div>
        <div class="p-6 md:w-2/3">
          <p class="text-sm text-gray-500 mb-1 capitalize"><%= product.category.replace('-', ' ') %></p>
          <h1 class="text-2xl font-bold mb-3"><%= product.name %></h1>
          <p class="text-3xl text-green-700 font-extrabold mb-2">Rp<%= product.price.toLocaleString('id-ID') %></p>
          <p class="text-gray-600 mb-6">Stok tersedia: <strong><%= product.stock %></strong> unit</p>

          <a href="/produk" class="inline-block text-green-700 font-medium hover:underline">&larr; Kembali ke daftar produk</a>
        </div>
      </article>
    <% } %>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>
