<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">

  <%- include('partials/navbar') %>

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="bg-green-600 text-white">
      <div class="max-w-6xl mx-auto px-4 py-16 grid md:grid-cols-2 gap-8 items-center">
        <div>
          <h1 class="text-3xl md:text-4xl font-extrabold mb-4">
            Belanja Sembako Jadi Lebih Mudah
          </h1>
          <p class="mb-6 text-green-50">
            Cek stok dan harga terbaru langsung dari website, tanpa perlu chat WhatsApp bolak-balik. Ada juga fitur Tanya AI buat jawab pertanyaan cepat kamu!
          </p>
          <a href="/produk" class="inline-block bg-white text-green-700 font-semibold px-6 py-3 rounded-lg shadow hover:bg-green-50 transition">
            Lihat Semua Produk
          </a>
        </div>
        <div class="hidden md:block">
          <div class="bg-green-500/40 rounded-xl h-56 flex items-center justify-center text-6xl">
            🛒🥫🌾
          </div>
        </div>
      </div>
    </section>

    <!-- Preview Produk -->
    <section class="max-w-6xl mx-auto px-4 py-12" aria-labelledby="preview-heading">
      <div class="flex items-center justify-between mb-6">
        <h2 id="preview-heading" class="text-2xl font-bold">Produk Pilihan</h2>
        <a href="/produk" class="text-green-700 font-medium hover:underline">Lihat semua &rarr;</a>
      </div>

      <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-4">
        <% previewProducts.forEach(function(p) { %>
          <article class="bg-white rounded-lg shadow p-4 flex flex-col">
            <div class="bg-green-50 rounded h-24 flex items-center justify-center text-3xl mb-3">📦</div>
            <h3 class="font-semibold mb-1"><%= p.name %></h3>
            <p class="text-sm text-gray-500 mb-1 capitalize"><%= p.category.replace('-', ' ') %></p>
            <p class="text-green-700 font-bold mb-3">Rp<%= p.price.toLocaleString('id-ID') %></p>
            <a href="/produk/<%= p.id %>" class="mt-auto text-sm text-center bg-green-600 text-white py-2 rounded hover:bg-green-700 transition">
              Lihat Detail
            </a>
          </article>
        <% }); %>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>
